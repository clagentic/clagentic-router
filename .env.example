# clagentic-router environment variables
#
# Copy to .env and fill in values for local development.
# Never commit .env — it is listed in .gitignore.
# Values set here override the equivalent fields in router.yaml.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bearer token that all authenticated API and CLI clients must present.
# Set to any strong random string; used as: Authorization: Bearer <value>
# Maps to: proxy.token in router.yaml
CLAGENTIC_ROUTER_TOKEN=

# ---------------------------------------------------------------------------
# Logging (optional)
# ---------------------------------------------------------------------------

# Log verbosity. Default: info
# Values: debug | info | warn | error
# Overrides: log.level in router.yaml
CLAGENTIC_ROUTER_LOG_LEVEL=info

# Log format. Default: text
# Values: text | json
# Use json for structured log ingestion (Loki, CloudWatch, Datadog, etc.)
# Overrides: log.format in router.yaml
CLAGENTIC_ROUTER_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Client / CLI (optional)
# ---------------------------------------------------------------------------

# URL of the router daemon for client subcommands (health, call, logs, etc.)
# Default: http://localhost:8765
CLAGENTIC_ROUTER_URL=http://localhost:8765

# Config file path for the serve subcommand.
# Default search order: ./router.yaml, ~/.config/clagentic-router/router.yaml,
#   /etc/clagentic-router/router.yaml
# CLAGENTIC_ROUTER_CONFIG=router.yaml

# ---------------------------------------------------------------------------
# API backend keys (optional)
# ---------------------------------------------------------------------------
# These are only needed when using API-based adapters (anthropic_api, openai_api).
# CLI adapters (claude_cli, codex_cli) use OAuth sessions — no key required.
#
# Reference in router.yaml as:  api_key: env:ANTHROPIC_API_KEY

# Anthropic API key — required for anthropic_api adapter backends.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — required for openai_api adapter backends.
# Also used by the optional OpenAI usage poller (openai_api_key field).
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Webhook secret (optional)
# ---------------------------------------------------------------------------
# HMAC secret for webhook delivery signature verification.
# Reference in router.yaml as:  secret: env:WEBHOOK_SECRET
# WEBHOOK_SECRET=
